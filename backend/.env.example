# Copy to .env and adjust for local/dev use. All of these have sane
# defaults for local development (see config/settings.py) — you only need
# a real .env for anything resembling production.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# mysql://USER:PASSWORD@HOST:PORT/NAME — omit to fall back to local SQLite.
DATABASE_URL=

CORS_ALLOW_ALL_ORIGINS=true
FRONTEND_BASE_URL=http://localhost:5173

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# true runs Celery tasks synchronously (no worker/broker needed) — fine
# for local dev, set to false in production with a worker running.
CELERY_TASK_ALWAYS_EAGER=true

# Defaults to printing emails to the console. Point at a real SMTP
# provider in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@race-timing-app.local

MAGIC_LINK_TTL_MINUTES=60
SESSION_TOKEN_TTL_HOURS=72
DUPLICATE_SCAN_WINDOW_SECONDS=120
BILLING_FREE_PARTICIPANT_THRESHOLD=50
BILLING_UNIT_PRICE=1.00
